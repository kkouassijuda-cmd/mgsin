# Copier ce fichier en .env et remplir les valeurs. Ne jamais envoyer .env sur GitHub.

# Clé secrète Django : en produire une avec
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Base PostgreSQL
DB_NAME=comptoir
DB_USER=comptoir
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Dépannage local sans PostgreSQL : décommenter la ligne suivante (base SQLite)
# DB_ENGINE=sqlite

# Informations du magasin (site et reçus)
MAGASIN_NOM=TechnoPièces
MAGASIN_ADRESSE=
MAGASIN_TELEPHONE=
MAGASIN_HORAIRES=

# Délai de rafraîchissement automatique des pages de suivi (secondes)
RAFRAICHISSEMENT_SECONDES=30
# Suivi en temps réel côté client (secondes)
SUIVI_CLIENT_SECONDES=10
# Seuil « stock bas » par défaut dans Gestion
STOCK_SEUIL_BAS=3
